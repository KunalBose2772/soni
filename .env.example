# ==============================================================================
# Sony Packers and Movers - Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL / Neon / Prisma)
# ------------------------------------------------------------------------------
# DATABASE_URL: Transaction pooler URL (e.g., port 6543 on Supabase)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct database connection URL for migrations (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. EMAIL NOTIFICATIONS (SMTP / Gmail / Hostinger / Brevo)
# ------------------------------------------------------------------------------
# When a client fills a quote form:
# - Admin receives full lead details and quick one-tap WhatsApp/call links
# - Customer receives a professional branded confirmation email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="sonypackersranchi@gmail.com"
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_PASS="your-16-char-app-password"

# Optional: Where admin alerts are sent (defaults to SMTP_USER if omitted)
ADMIN_EMAIL="sonypackersranchi@gmail.com"

# ------------------------------------------------------------------------------
# 3. ADMIN PORTAL & SECURITY
# ------------------------------------------------------------------------------
# Minimum 32-character random string used to encrypt session cookies
SESSION_SECRET="generate-a-strong-32-char-random-secret-key-here"

# Admin login credentials
ADMIN_LOGIN_ID="Admin"
ADMIN_PASSWORD="YourSecureAdminPassword123!"

# ------------------------------------------------------------------------------
# 4. SUPABASE STORAGE (Gallery & Image Uploads)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional: Custom storage bucket CDN base URL if configured
# NEXT_PUBLIC_SUPABASE_STORAGE_BASE_URL="https://[PROJECT_REF].supabase.co/storage/v1/object/public/gallery"

# ------------------------------------------------------------------------------
# 5. PUBLIC SITE URL (SEO Canonical & Sitemap)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://sonypackers.in"
